# VoxDetect Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env.

APP_NAME=VoxDetect
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Database (SQLite for MVP; update to postgresql+asyncpg://... for production)
DATABASE_URL=sqlite+aiosqlite:///./data/voxdetect.db

# Organisation profile used when none is specified
DEFAULT_ORG=enterprise

# Maximum audio upload size
MAX_UPLOAD_SIZE_MB=25

# Streaming chunk window (seconds, informational — chunks are client-driven)
STREAM_CHUNK_SECONDS=3
# Number of recent chunks to include in the rolling risk median
STREAM_ROLLING_WINDOW=5

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Webhook timeout in seconds
WEBHOOK_TIMEOUT_SECONDS=5

# ML Core device: cpu | cuda | auto
MODEL_DEVICE=cpu

# Optional: path to fine-tuned checkpoint dir (leave blank for default pretrained)
# MODEL_CHECKPOINT=/path/to/checkpoint_dir

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
